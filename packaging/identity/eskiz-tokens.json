    "size": 13,
    "weight": 500,
    "figures": "tabular via fixed digit cells (egui 0.36 cannot switch OpenType features)"
   }
  },
  "min_size_pt": 11
 },
 "shape": {
  "radius": {
   "xs": 2,
   "sm": 4,
   "md": 8,
   "lg": 12,
   "pill": "full"
  },
  "radius_use": {
   "xs": "slider rails, ticks",
   "sm": "buttons, fields, checkboxes, chips",
   "md": "rows, popovers, docks",
   "lg": "modal sheets",
   "pill": "size chip, Show UI pill"
  },
  "stroke": {
   "hairline": 1.0,
   "control_edge": 1.0,
   "icon": 1.5,
   "focus_ring": 2.0,
   "focus_halo": 1.0,
   "slider_rail": 3.0,
   "slider_thumb": 18.0
  },
  "spacing": {
   "0": 0,
   "1": 2,
   "2": 4,
   "3": 8,
   "4": 12,
   "5": 16,
   "6": 24,
   "7": 32
  },
  "icon": {
   "grid": 24,
   "stroke": 1.5,
   "padding": 2,
   "render": {
    "compact": 20,
    "regular": 24,
    "touch": 28
   }
  },
  "eskiz_radius": {
   "panel": 8,
   "window": 8,
   "menu": 8,
   "widget": 4,
   "checkbox": 2,
   "banner": 4,
   "bubble": 4,
   "toast": 6,
   "sidebar_pill": "full",
   "text_field": 4
  },
  "eskiz_shadow": {
   "offset": [
    0,
    0
   ],
   "blur": 0,
   "alpha": 0
  }
 },
 "elevation": {
  "e0": {
   "use": "canvas backdrop",
   "shadow": null
  },
  "e1": {
   "use": "top bar, docks",
   "fill": "bar",
   "alpha": 0.92,
   "shadow": null,
   "edge": "hairline"
  },
  "e2": {
   "use": "popovers, panels",
   "fill": "panel",
   "alpha": 1.0,
   "shadow": {
    "offset": [
     0,
     4
    ],
    "blur": 16,
    "alpha": 0.35
   },
   "edge": "hairline"
  },
  "e3": {
   "use": "modal sheets",
   "fill": "panel",
   "alpha": 1.0,
   "shadow": {
    "offset": [
     0,
     8
    ],
    "blur": 32,
    "alpha": 0.45
   },
   "scrim": 0.5
  },
  "rules": [
   "Only e1 may be translucent, and never below 0.92 alpha",
   "No backdrop blur (egui cannot); translucency is a tint only",
   "Panels are opaque so text contrast is computed on a known colour"
  ]
 },
 "density": {
  "compact": {
   "hit": 36,
   "icon": 20,
   "row": 32,
   "item_spacing": 6,
   "button_padding": [
    8,
    4
   ],
   "bar_height": 40,
   "body": 13,
   "note": "desktop opt-in, fine pointer"
  },
  "regular": {
   "hit": 44,
   "icon": 24,
   "row": 40,
   "item_spacing": 8,
   "button_padding": [
    10,
    6
   ],
   "bar_height": 48,
   "body": 13,
   "note": "default; equals current BUTTON=44, BAR_HEIGHT=48"
  },
  "touch": {
   "hit": 48,
   "icon": 28,
   "row": 48,
   "item_spacing": 12,
   "button_padding": [
    12,
    8
   ],
   "bar_height": 56,
   "body": 15,
   "note": "Android and any device with touch input as primary"
  },
  "min_target_floor": 24,
  "floor_source": "WCAG 2.2 SC 2.5.8 (AA)"
 },
 "motion": {
  "fast_ms": 100,
  "base_ms": 150,
  "slow_ms": 250,
  "easing": "cubic-out",
  "reduce_motion": "all durations 0, no slide"
 }
}

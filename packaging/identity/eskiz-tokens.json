{
 "meta": {
  "name": "Eskiz identity tokens (checked-in copy)",
  "note": "Eskiz palette (RC3 minimal): neutral graphite chrome, flat surfaces with 1 px hairlines, nib orange (primary) only for the active tool or tab and the primary button, Atkinson Hyperlegible Next. theme.rs must match this file (test identity_tokens_match_the_checked_in_json).",
  "contrast": "WCAG 2.x relative luminance ratio; bar composited at its alpha over the backdrop",
  "units": "logical points (egui points)"
 },

 "overlay": {
  "ants": {
   "a": "#000000",
   "b": "#FFFFFF",
   "width": 1.0,
   "dash": 4.0,
   "speed_px_per_s": 8.0,
   "worst_case_ratio_on_any_grey": 4.61,
   "note": "values equal the current constants in easel-select outline.rs; kept because black/white is hue independent"
  },
  "handle": {
   "fill": "#FFFFFF",
   "outline": "#000000",
   "outline_width": 1.0,
   "size": 10.0,
   "hover_fill": "accent_fill",
   "hover_ink": "on_accent"
  },
  "brush_cursor": {
   "ring": "#FFFFFF",
   "outline": "#000000",
   "width": 1.0
  },
  "scrim": {
   "modal": "#000000",
   "modal_alpha": 0.5
  }
 },
 "typography": {
  "ui_family": {
   "recommended": "Atkinson Hyperlegible Next",
   "licence": "SIL OFL 1.1",
   "file": "AtkinsonHyperlegibleNext[wght].ttf",
   "bytes": 114552,
   "fallback_static": [
    "AtkinsonHyperlegible-Regular.ttf (54348 bytes)",
    "AtkinsonHyperlegible-Bold.ttf (55256 bytes)"
   ],
   "cjk_arabic_etc": "fall back to egui default and system fonts",
   "source": "https://github.com/google/fonts/tree/main/ofl/atkinsonhyperlegiblenext"
  },
  "alternatives": [
   {
    "name": "Inter",
    "bytes": 876576,
    "licence": "OFL 1.1"
   },
   {
    "name": "IBM Plex Sans",
    "bytes": 537244,
    "licence": "OFL 1.1"
   },
   {
    "name": "Source Sans 3",
    "bytes": 646340,
    "licence": "OFL 1.1"
   }
